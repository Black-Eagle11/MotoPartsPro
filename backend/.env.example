
APP_NAME="MotoPartsPro"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==========================================================
# DATABASE
# ==========================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motopartspro
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================
# SESSION / CACHE / QUEUE
# ==========================================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ==========================================================
# FILE STORAGE
# ==========================================================

FILESYSTEM_DISK=local

# ==========================================================
# BCRYPT
# ==========================================================

BCRYPT_ROUNDS=12

# ==========================================================
# FRONTEND CORS
# ==========================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================================
# ADMIN SEEDER
# Wajib diisi jika ingin membuat akun admin awal.
# Jangan menyimpan password asli di repository.
# ==========================================================

MOTOPARTSPRO_ADMIN_NAME="MotoPartsPro Admin"
MOTOPARTSPRO_ADMIN_EMAIL=
MOTOPARTSPRO_ADMIN_PASSWORD=

# ==========================================================
# MAIL
# ==========================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@motopartspro.test"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================
# FRONTEND URL
# ==========================================================

FRONTEND_URL=http://localhost:5173
