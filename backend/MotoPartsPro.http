
@baseUrl = http://127.0.0.1:8000/api
@token = PASTE_BEARER_TOKEN_HERE
@productId = 1
@categoryId = 1
@orderId = 1
@userId = 2

### 1. Register Member Baru
POST {{baseUrl}}/register
Content-Type: application/json
Accept: application/json

{
  "name": "MotoParts Member",
  "email": "member@example.test",
  "password": "StrongPassword123!",
  "password_confirmation": "StrongPassword123!"
}

### 2. Login
# Salin nilai token dari respons lalu masukkan ke @token.
POST {{baseUrl}}/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@motopartspro.test",
  "password": "GANTI_DENGAN_PASSWORD_ADMIN"
}

### 3. Current User
GET {{baseUrl}}/user
Accept: application/json
Authorization: Bearer {{token}}

### 4. Dashboard
GET {{baseUrl}}/dashboard
Accept: application/json
Authorization: Bearer {{token}}

### 5. Logout
POST {{baseUrl}}/logout
Accept: application/json
Authorization: Bearer {{token}}

### 6. List Kategori
GET {{baseUrl}}/categories?search=engine&per_page=10&page=1
Accept: application/json
Authorization: Bearer {{token}}

### 7. Detail Kategori
GET {{baseUrl}}/categories/{{categoryId}}
Accept: application/json
Authorization: Bearer {{token}}

### 8. Create Kategori
POST {{baseUrl}}/categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "Engine Test",
  "slug": "engine-test",
  "description": "Kategori untuk pengujian API",
  "is_active": true
}

### 9. Update Kategori
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "description": "Kategori yang telah diperbarui"
}

### 10. Delete Kategori
# Hanya berhasil jika kategori tidak mempunyai produk.
DELETE {{baseUrl}}/categories/{{categoryId}}
Accept: application/json
Authorization: Bearer {{token}}

### 11. List Produk dengan Search, Filter, dan Pagination
GET {{baseUrl}}/products?search=chain&category_id={{categoryId}}&sort=price&direction=asc&per_page=10&page=1
Accept: application/json
Authorization: Bearer {{token}}

### 12. Detail Produk
GET {{baseUrl}}/products/{{productId}}
Accept: application/json
Authorization: Bearer {{token}}

### 13. Create Produk
POST {{baseUrl}}/products
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "category_id": {{categoryId}},
  "sku": "MTP-HTTP-0001",
  "name": "Rantai Motor Test",
  "slug": "rantai-motor-test",
  "brand": "Universal",
  "description": "Produk untuk pengujian API",
  "price": "125000.00",
  "cost_price": "95000.00",
  "min_stock": 5,
  "is_active": true
}

### 14. Update Produk
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "price": "130000.00",
  "description": "Harga produk yang diperbarui"
}

### 15. Delete Produk
# Hanya berhasil jika tidak mempunyai riwayat order atau stok.
DELETE {{baseUrl}}/products/{{productId}}
Accept: application/json
Authorization: Bearer {{token}}

### 16. Riwayat Pergerakan Stok
GET {{baseUrl}}/inventory/movements?product_id={{productId}}&per_page=15&page=1
Accept: application/json
Authorization: Bearer {{token}}

### 17. Barang Masuk
POST {{baseUrl}}/inventory/adjustments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "product_id": {{productId}},
  "movement_type": "stock_in",
  "quantity": 10,
  "unit_cost": "95000.00",
  "notes": "Stok masuk hasil pengadaan"
}

### 18. Penyesuaian Stok
POST {{baseUrl}}/inventory/adjustments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "product_id": {{productId}},
  "movement_type": "adjustment_out",
  "quantity": 1,
  "notes": "Koreksi stok setelah pemeriksaan"
}

### 19. Checkout
POST {{baseUrl}}/orders
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "items": [
    {
      "product_id": {{productId}},
      "quantity": 1
    }
  ],
  "shipping_name": "Customer Test",
  "shipping_phone": "081234567890",
  "shipping_address": "Jalan Pengujian Nomor 10",
  "shipping_city": "Garut",
  "shipping_province": "Jawa Barat",
  "shipping_postal_code": "44100",
  "notes": "Pengujian checkout"
}

### 20. List Pesanan
GET {{baseUrl}}/orders?per_page=15&page=1
Accept: application/json
Authorization: Bearer {{token}}

### 21. Detail Pesanan
GET {{baseUrl}}/orders/{{orderId}}
Accept: application/json
Authorization: Bearer {{token}}

### 22. Update Status Pesanan
PATCH {{baseUrl}}/orders/{{orderId}}/status
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "status": "confirmed"
}

### 23. Batalkan Pesanan
PATCH {{baseUrl}}/orders/{{orderId}}/cancel
Accept: application/json
Authorization: Bearer {{token}}

### 24. List Pengguna (Admin)
GET {{baseUrl}}/users?search=member&per_page=15&page=1
Accept: application/json
Authorization: Bearer {{token}}

### 25. Detail Pengguna
GET {{baseUrl}}/users/{{userId}}
Accept: application/json
Authorization: Bearer {{token}}

### 26. Update Role Pengguna (Admin)
PATCH {{baseUrl}}/users/{{userId}}/role
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "role": "staff"
}

### 27. Aktifkan Pengguna (Admin)
PATCH {{baseUrl}}/users/{{userId}}/activate
Accept: application/json
Authorization: Bearer {{token}}

### 28. Nonaktifkan Pengguna (Admin)
PATCH {{baseUrl}}/users/{{userId}}/deactivate
Accept: application/json
Authorization: Bearer {{token}}

### 29. Hapus Pengguna (Admin)
# Hanya diizinkan jika UserPolicy membolehkan penghapusan.
DELETE {{baseUrl}}/users/{{userId}}
Accept: application/json
Authorization: Bearer {{token}}
